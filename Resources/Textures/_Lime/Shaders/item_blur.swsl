// Lime Station: вертикальное размытие и усиление мягкого свечения предметов.
light_mode unshaded;
blend_mode none;
uniform highp float blurPixels;

void fragment() {
    highp vec4 glow = vec4(0.0);
    highp float totalWeight = 0.0;
    for (highp int y = -12; y <= 12; y++) {
        highp float offset = float(y);
        highp float weight = 0.65 * exp(-offset * offset / 4.5) / 1.5
            + 0.35 * exp(-offset * offset / (2.0 * blurPixels * blurPixels)) / blurPixels;
        highp vec2 position = UV + vec2(0.0, offset) * TEXTURE_PIXEL_SIZE;
        if (position.y >= 0.0 && position.y <= 1.0)
            glow += zTexture(position) * weight;
        totalWeight += weight;
    }
    glow /= totalWeight;
    // Финальный add-проход умножает RGB на альфу ровно один раз.
    COLOR = vec4(glow.rgb / max(glow.a, 0.0001), min(glow.a * 2.5, 1.0));
}
