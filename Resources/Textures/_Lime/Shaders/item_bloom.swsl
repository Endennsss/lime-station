// SPDX-License-Identifier: MIT
// Lime Station: горизонтальный проход независимого размытия текущего кадра.
light_mode unshaded;
blend_mode none;
uniform highp vec2 uvScale;
uniform highp vec2 sourcePixels;
uniform highp float paddingPixels;
uniform highp float blurPixels;

highp vec4 sourceAt(highp vec2 position, highp vec2 origin) {
    // За границей кадра — прозрачность, не соседний кадр RSI-атласа.
    if (position.x < 0.0 || position.y < 0.0 || position.x > 1.0 || position.y > 1.0)
        return vec4(0.0);
    highp vec2 safePosition = clamp(position, vec2(0.5) / sourcePixels, vec2(1.0) - vec2(0.5) / sourcePixels);
    highp vec4 sampleColor = zTexture(origin + safePosition * uvScale);
    return vec4(sampleColor.rgb * sampleColor.a, sampleColor.a);
}

void fragment() {
    highp vec2 origin = UV - UV2 * uvScale;
    highp vec2 position = (UV2 - vec2(0.5)) * (sourcePixels + vec2(paddingPixels * 2.0)) / sourcePixels + vec2(0.5);
    highp vec4 glow = vec4(0.0);
    highp float totalWeight = 0.0;
    for (highp int x = -12; x <= 12; x++) {
        highp float offset = float(x);
        // Плотный ближний свет и широкий мягкий ореол, без квадратной маски.
        highp float weight = 0.65 * exp(-offset * offset / 4.5) / 1.5
            + 0.35 * exp(-offset * offset / (2.0 * blurPixels * blurPixels)) / blurPixels;
        glow += sourceAt(position + vec2(offset, 0.0) / sourcePixels, origin) * weight;
        totalWeight += weight;
    }
    glow /= totalWeight;
    COLOR = glow;
}
